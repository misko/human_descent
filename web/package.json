{
  "name": "hudes",
  "version": "1.0.0",
  "description": "human descent on MNIST",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prebuild": "npm run -s proto:compile",
    "build": "VITE_BUILD_ID=${VITE_BUILD_ID:-$(date +%s)} VITE_WS_URL=${VITE_WS_URL:-/ws} VITE_HTTP_API=${VITE_HTTP_API:-/api} vite build",
    "prebuild:port10000": "npm run -s proto:compile",
    "build:port10000": "VITE_WS_URL=/ws VITE_HTTP_API=/api vite build",
    "proto:compile": "npm run -s proto:compile:py && npm run -s proto:compile:js",
    "proto:compile:py": "${HUDES_PYTHON:-python} -m grpc_tools.protoc --proto_path=../hudes --python_out=../hudes ../hudes/hudes.proto",
    "proto:compile:js": "mkdir -p generated && npx pbjs -t static-module -w es6 -o generated/hudes_pb.js ../hudes/hudes.proto && npx pbts -o generated/hudes_pb.d.ts generated/hudes_pb.js",
    "proto:sync": "npm run -s proto:compile",
    "predev": "npm run -s proto:sync",
    "dev": "vite --host 0.0.0.0 --port 6173",
    "preview": "vite preview --port 6173",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:unit": "node ./tests/run-unit.mjs",
    "test:frontend": "npm run -s test:unit && npm run -s test:e2e:chromium",
    "test": "npm run -s test:frontend"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chart.js": "4.5.1",
    "chartjs-chart-matrix": "3.1.0",
    "chartjs-plugin-annotation": "3.1.0",
    "heatmap.js": "2.0.5",
    "protobufjs": "8.8.1",
    "protobufjs-cli": "2.7.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "http-server": "14.1.1",
    "rollup-plugin-visualizer": "7.1.1",
    "vite": "8.3.5",
    "vite-plugin-bundle-analyzer": "0.0.1",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  }
}
